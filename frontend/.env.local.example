# CropSense AI — Frontend environment variables
#
# Copy this file to .env.local and adjust values for your environment.
# .env.local is gitignored and should never be committed.

# Base URL of the FastAPI backend.
# Default (local development): http://127.0.0.1:8000
# Change this when deploying to a remote server or a different port.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

