# Copy this file to .env and fill in your values.
# Never commit .env to version control.

GEMINI_API_KEY=your_google_ai_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev default (localhost:3000) is used when this is unset.
# In production, set this to your Vercel deployment URL, e.g.:
# ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=

# ── PostgreSQL / database ─────────────────────────────────────────────────────
# Used by docker-compose (start with: docker compose --env-file backend/.env up -d)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=cropsense
POSTGRES_PASSWORD=your_local_postgres_password
POSTGRES_DB=cropsense

# Used by the backend (Task 2+). If omitted, it is built from the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://cropsense:your_local_postgres_password@127.0.0.1:5433/cropsense
UPLOADS_DIR=backend/data/uploads
SESSION_TTL_DAYS=30
MAX_UPLOAD_BYTES=10485760
